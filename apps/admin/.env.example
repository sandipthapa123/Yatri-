# Copy to .env.local and fill in for local development.

# Base URL of the Yatri API (apps/api), including the /api/v1 prefix.
API_BASE_URL=http://localhost:4000/api/v1

# Must be byte-for-byte identical to apps/api's JWT_ACCESS_SECRET — the
# admin app verifies access-token JWTs locally in middleware instead of
# calling the API on every navigation. Never expose this to the browser
# (no NEXT_PUBLIC_ prefix).
JWT_ACCESS_SECRET=
