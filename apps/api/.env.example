# Copy to .env and fill in for local development. Never commit the real .env.

NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://yatri:yatri@localhost:5432/yatri_dev

# Redis — used for OTP rate limiting/cooldowns. Reserved for future realtime
# features too (driver presence, live location fanout).
REDIS_URL=redis://localhost:6379

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# --- Auth / sessions ---
# Required, >= 32 chars, must not look like a placeholder. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- OTP ---
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUEST_MAX_PER_WINDOW=5
OTP_REQUEST_WINDOW_MINUTES=15
OTP_IP_REQUEST_MAX_PER_WINDOW=20

# DEVELOPMENT ONLY. When true, request-otp returns the generated code in the
# API response and logs it, instead of sending a real SMS. The server
# refuses to start with this true when NODE_ENV=production.
OTP_DEV_MODE=true

# --- SMS provider ---
# "console" just logs the OTP (fine for local dev, refused in production).
# "http" posts to SMS_HTTP_ENDPOINT with SMS_HTTP_API_KEY — point this at
# whatever provider you integrate (e.g. Sparrow SMS, Twilio) later.
SMS_PROVIDER=console
SMS_HTTP_ENDPOINT=
SMS_HTTP_API_KEY=

# --- Admin seed (development only) ---
# Used by `pnpm seed:admin`. The script refuses to run when NODE_ENV=production.
# Leave unset in any real environment; create admin accounts out-of-band instead.
ADMIN_SEED_EMAIL=admin@yatri.local
ADMIN_SEED_PASSWORD=change-this-dev-only-password

# --- Document storage ---
# "local" is the only provider implemented; the StorageProvider interface
# (apps/api/src/lib/storage) is ready for an S3/GCS-backed one in production.
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage
# Required, >= 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
STORAGE_SIGNING_SECRET=
STORAGE_SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_FILE_SIZE_BYTES=8388608

# --- Location / maps (Phase 4) ---
# "nominatim" = any Nominatim-compatible geocoder (OSM Nominatim, self-hosted, LocationIQ...).
# "static" = tiny offline gazetteer of Nepali places (dev/tests, no network). "none" disables geocoding (endpoints return 503). The public OSM server is for local dev
# only and is REFUSED when NODE_ENV=production.
LOCATION_PROVIDER=nominatim
LOCATION_PROVIDER_BASE_URL=https://nominatim.openstreetmap.org
# Optional key for commercial providers. Server-side only; never committed or returned to clients.
LOCATION_PROVIDER_API_KEY=
# Nominatim policy requires an identifying User-Agent with a contact.
LOCATION_PROVIDER_USER_AGENT=Yatri-API/0.1 (you@example.com)
# Comma-separated ISO country codes results are restricted to. Add more to expand beyond Nepal.
LOCATION_COUNTRY_CODES=np
LOCATION_REQUEST_TIMEOUT_MS=4000
LOCATION_SEARCH_CACHE_TTL_SECONDS=86400
LOCATION_REVERSE_CACHE_TTL_SECONDS=86400
# "haversine" = straight-line only. "osrm" | "graphhopper" | "valhalla" = road distance/ETA from that engine.
LOCATION_ROUTING_PROVIDER=haversine
LOCATION_ROUTING_BASE_URL=https://router.project-osrm.org
# Optional key for hosted GraphHopper/Valhalla. Server-side only.
LOCATION_ROUTING_API_KEY=
LOCATION_SEARCH_RATE_LIMIT_PER_MINUTE=60

# --- Live tracking (Phase 5) ---
# Location updates arriving faster than this per party are dropped.
TRACKING_MIN_INTERVAL_MS=800
# Minimum pause between reverse-geocode lookups for one moving party.
TRACKING_PLACE_REFRESH_MS=15000
