# Copy to .env and fill in for local development. Never commit the real .env.

NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://yatri:yatri@localhost:5432/yatri_dev

# Redis — used for OTP rate limiting/cooldowns. Reserved for future realtime
# features too (driver presence, live location fanout).
REDIS_URL=redis://localhost:6379

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# --- Auth / sessions ---
# Required, >= 32 chars, must not look like a placeholder. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- OTP ---
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUEST_MAX_PER_WINDOW=5
OTP_REQUEST_WINDOW_MINUTES=15
OTP_IP_REQUEST_MAX_PER_WINDOW=20

# DEVELOPMENT ONLY. When true, request-otp returns the generated code in the
# API response and logs it, instead of sending a real SMS. The server
# refuses to start with this true when NODE_ENV=production.
OTP_DEV_MODE=true

# --- SMS provider ---
# "console" just logs the OTP (fine for local dev, refused in production).
# "http" posts to SMS_HTTP_ENDPOINT with SMS_HTTP_API_KEY — point this at
# whatever provider you integrate (e.g. Sparrow SMS, Twilio) later.
SMS_PROVIDER=console
SMS_HTTP_ENDPOINT=
SMS_HTTP_API_KEY=

# --- Admin seed (development only) ---
# Used by `pnpm seed:admin`. The script refuses to run when NODE_ENV=production.
# Leave unset in any real environment; create admin accounts out-of-band instead.
ADMIN_SEED_EMAIL=admin@yatri.local
ADMIN_SEED_PASSWORD=change-this-dev-only-password
# Dev only: permissions for the seeded admin, e.g. DRIVER_LOCATION_VIEW (exact driver coordinates).
ADMIN_SEED_PERMISSIONS=ALL

# --- Document storage ---
# "local" is the only provider implemented; the StorageProvider interface
# (apps/api/src/lib/storage) is ready for an S3/GCS-backed one in production.
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage
# Required, >= 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
STORAGE_SIGNING_SECRET=
STORAGE_SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_FILE_SIZE_BYTES=8388608

# --- Location / maps (Phase 4) ---
# "nominatim" = any Nominatim-compatible geocoder (OSM Nominatim, self-hosted, LocationIQ...).
# "static" = tiny offline gazetteer of Nepali places (dev/tests, no network). "none" disables geocoding (endpoints return 503). The public OSM server is for local dev
# only and is REFUSED when NODE_ENV=production.
LOCATION_PROVIDER=nominatim
LOCATION_PROVIDER_BASE_URL=https://nominatim.openstreetmap.org
# Optional key for commercial providers. Server-side only; never committed or returned to clients.
LOCATION_PROVIDER_API_KEY=
# Nominatim policy requires an identifying User-Agent with a contact.
LOCATION_PROVIDER_USER_AGENT=Yatri-API/0.1 (you@example.com)
# Comma-separated ISO country codes results are restricted to. Add more to expand beyond Nepal.
LOCATION_COUNTRY_CODES=np
LOCATION_REQUEST_TIMEOUT_MS=4000
LOCATION_SEARCH_CACHE_TTL_SECONDS=86400
LOCATION_REVERSE_CACHE_TTL_SECONDS=86400
# "haversine" = straight-line only. "osrm" | "graphhopper" | "valhalla" = road distance/ETA from that engine.
LOCATION_ROUTING_PROVIDER=haversine
LOCATION_ROUTING_BASE_URL=https://router.project-osrm.org
# Optional key for hosted GraphHopper/Valhalla. Server-side only.
LOCATION_ROUTING_API_KEY=
LOCATION_SEARCH_RATE_LIMIT_PER_MINUTE=60

# --- Live tracking (Phase 5) ---
# Location updates arriving faster than this per party are dropped.
TRACKING_MIN_INTERVAL_MS=800
# Minimum pause between reverse-geocode lookups for one moving party.
TRACKING_PLACE_REFRESH_MS=15000

# --- Driver availability (Phase 5) ---
DRIVER_LOCATION_FRESH_SECONDS=30
DRIVER_LOCATION_LOST_SECONDS=60
DRIVER_STALE_TIMEOUT_SECONDS=180
DRIVER_UPDATE_INTERVAL_IDLE_MS=10000
DRIVER_UPDATE_INTERVAL_EN_ROUTE_MS=3000
DRIVER_UPDATE_INTERVAL_ON_TRIP_MS=3000
DRIVER_ONLINE_MAX_ACCURACY_METERS=100
DRIVER_LOCATION_PERSIST_SECONDS=20
DRIVER_TRANSITION_TIMEOUT_SECONDS=30

# --- Pricing & waiting (Phase 6; whole NPR) ---
FARE_BASE_NPR=50
FARE_PER_KM_NPR=30
FARE_PER_MINUTE_NPR=2
FARE_MINIMUM_NPR=100
WAITING_FREE_SECONDS=180
WAITING_PER_MINUTE_NPR=5
NO_SHOW_AFTER_SECONDS=300
WAITING_NOTIFY_SECONDS=120,240,360,480,600
NEARBY_NOTIFY_METERS=1000,500,200

# The driver must be this close to the pickup for "I have arrived" to be accepted (server-checked).
TRIP_ARRIVAL_RADIUS_METERS=150

# --- Dispatch ---
DISPATCH_RADIUS_METERS=5000
DISPATCH_OFFER_TTL_SECONDS=20
DISPATCH_SEARCH_TIMEOUT_SECONDS=120
DISPATCH_MAX_OFFERS=6
TRIP_DRIVER_LOST_SECONDS=120

# --- Matching and cancellation ---
MATCHING_STRATEGY=eta_workload
# Free cancellation window after a driver is assigned; a later cancellation records this fee (0 = none).
CANCEL_FREE_SECONDS=120
CANCEL_FEE_NPR=0

# --- Safety ---
EMERGENCY_CONTACTS_MAX=5
# The number the apps offer to call in an emergency (Nepal Police).
EMERGENCY_SERVICES_NUMBER=100

# --- Trip sharing (trusted contact) ---
SHARE_DURATION_HOURS=6
SHARE_MAX_PER_TRIP=5
SHARE_ENDED_GRACE_MINUTES=15
# The API host that serves the contact's page; share links are PUBLIC_BASE_URL/share/<token>
PUBLIC_BASE_URL=http://localhost:4000

# --- Chat ---
CHAT_OPEN_AFTER_TRIP_MINUTES=15
# Chat text retention is a retention policy (Admin > Privacy > Retention), not an environment value.
CHAT_RATE_LIMIT_PER_MINUTE=30

# --- Calls (WebRTC) ---
CALL_RING_TIMEOUT_SECONDS=45
# Only "webrtc" exists; a new provider is a new class behind calls/call-provider.ts
CALL_PROVIDER=webrtc
# Public STUN is fine for development. Production audio/video behind mobile NAT needs a TURN server
# (e.g. coturn with use-auth-secret); set its URLs and the shared secret. Never commit the secret.
CALL_STUN_URLS=stun:stun.l.google.com:19302
CALL_TURN_URLS=
CALL_TURN_SHARED_SECRET=
CALL_TURN_CREDENTIAL_TTL_SECONDS=3600

# --- Platform settings (defaults; an admin can override the ones listed in @yatri/types settings.ts) ---
SERVICE_REQUESTS_ENABLED=true
SERVICE_PAUSED_MESSAGE=Ride requests are paused for a short while. Please try again soon.
# Seconds a process caches settings before re-reading them (changes made on this process apply at once).
SETTINGS_CACHE_SECONDS=10
# What "today" and a day mean in dashboards and reports.
PLATFORM_TIME_ZONE=Asia/Kathmandu

# --- Operations: logging, proxies, limits, database, shutdown ---
# debug | info | warn | error | silent. Default: info (error in tests). Logs are JSON outside development.
LOG_LEVEL=
# Identifies the running release in logs and /health (a git SHA or tag set by the deploy).
APP_VERSION=
# How many reverse proxies sit in front of the API (so req.ip is the real client). 0 = none. Too many lets a caller forge their address.
TRUST_PROXY_HOPS=1
# Generic per-IP ceiling for the whole API, per minute. Auth, OTP, SOS, uploads and chat have their own, stricter limits.
API_RATE_LIMIT_PER_MINUTE=600
# Per signed-in user, per minute, for state-changing requests (POST, PUT, PATCH, DELETE).
MUTATION_RATE_LIMIT_PER_MINUTE=120
# TLS to Postgres (required by most managed databases). Only relax verification on a private network you control.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
# Postgres cancels any statement running longer than this.
DB_STATEMENT_TIMEOUT_MS=15000
# A Redis command with no answer in this time fails instead of hanging the request.
REDIS_COMMAND_TIMEOUT_MS=3000
# On SIGTERM the server stops accepting work and waits at most this long before exiting.
SHUTDOWN_TIMEOUT_MS=10000

# --- Support and privacy (defaults; editable in Admin > Settings) ---
# Resolved tickets nobody replied to are closed after this many days (0 = never automatically).
SUPPORT_AUTO_CLOSE_DAYS=7
SUPPORT_MAX_ATTACHMENTS_PER_TICKET=6
# The due date shown on account-deletion and data-access requests.
DATA_REQUEST_RESPONSE_DAYS=30
# How often escalations, auto-close and the retention job run.
SUPPORT_SWEEP_SECONDS=300

# --- Dispatch, surge and driver limits (defaults; editable in Admin > Settings) ---
# Ranking: proximity (nearest first) or eta_workload (arrival time plus a penalty for recent rides).
# (MATCHING_STRATEGY is documented above.)
# Each unanswered offer widens the next search by this percent, up to the maximum radius.
DISPATCH_RADIUS_EXPANSION_PERCENT=25
DISPATCH_MAX_RADIUS_METERS=12000
DISPATCH_WORKLOAD_WINDOW_MINUTES=120
DISPATCH_WORKLOAD_PENALTY_SECONDS=60
# No pricing rule can raise a fare above this many times normal.
SURGE_MAX_MULTIPLIER=3
SURGE_DEMAND_WINDOW_MINUTES=15
# 0 = no limit.
DRIVER_MAX_RIDES_PER_DAY=0
DRIVER_MAX_ONLINE_HOURS=0
# Heatmap square size and the smallest count it will show (privacy).
HEATMAP_CELL_METERS=1000
HEATMAP_MIN_COUNT=3

# --- Fleet and driver operations (defaults; editable in Admin > Settings) ---
# Days before an expiry at which a reminder is sent; the largest also defines "expiring soon".
EXPIRY_REMINDER_DAYS=30,14,7,1
RESTRICTED_DRIVER_MAX_RIDES_PER_DAY=3
# How often documents, licences and service dates are checked (minutes).
FLEET_MONITOR_MINUTES=60
