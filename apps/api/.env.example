# Copy to .env and fill in for local development. Never commit the real .env.

NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://yatri:yatri@localhost:5432/yatri_dev

# Redis (reserved for future realtime features — not required to boot the API yet)
REDIS_URL=redis://localhost:6379

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:19006
