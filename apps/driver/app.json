{
  "expo": {
    "name": "Yatri Driver",
    "slug": "yatri-driver",
    "scheme": "yatri-driver",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D4ED8"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.yatri.driver"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1D4ED8"
      },
      "package": "app.yatri.driver"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yatri uses your location only when you ask, to show where you are and share it with Yatri. It is not tracked in the background."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Yatri Driver uses your photo library so you can set a profile picture."
        }
      ]
    ]
  }
}
