{
  "expo": {
    "name": "Yatri",
    "slug": "yatri-passenger",
    "scheme": "yatri",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#C81E3A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.yatri.passenger"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C81E3A"
      },
      "package": "app.yatri.passenger"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yatri uses your location once, when you ask, to set your pickup point. It is not tracked in the background."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Yatri uses your photo library so you can set a profile picture."
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Yatri uses the camera only during a video call with your driver.",
          "microphonePermission": "Yatri uses the microphone only during a call with your driver."
        }
      ]
    ],
    "owner": "yatri.ride",
    "extra": {
      "eas": {
        "projectId": "b3bf6574-f1cb-4004-bf55-d8bcfcad7ddf"
      }
    }
  }
}
