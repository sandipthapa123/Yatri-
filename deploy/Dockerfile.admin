# syntax=docker/dockerfile:1
#
# The Yatri admin console (Next.js, standalone output). Build from the repository root:
#   docker build -f deploy/Dockerfile.admin -t yatri-admin:<release> .
# Runtime configuration (API_BASE_URL, JWT_ACCESS_SECRET) comes from the environment when the
# container starts; nothing secret is baked in. JWT_ACCESS_SECRET must equal the API's.

FROM node:20-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /repo

FROM base AS build
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/types/package.json packages/types/
COPY packages/shared/package.json packages/shared/
COPY apps/admin/package.json apps/admin/
RUN pnpm install --frozen-lockfile --filter @yatri/admin...
# The shared TypeScript settings every tsconfig extends (packages/config/typescript/base.json).
COPY packages/config packages/config
COPY packages/types packages/types
COPY packages/shared packages/shared
COPY apps/admin apps/admin
# The build only needs to *load* the environment schema, so it gets placeholder values for this one command only (an ENV
# line would keep them in the image; real values are supplied at run time). @yatri/types is used at run time from its
# compiled dist/, so it is built first (as the API image does).
RUN pnpm --filter @yatri/types build && \
    API_BASE_URL=http://localhost:4000/api/v1 \
    JWT_ACCESS_SECRET=build-time-placeholder-not-used-at-run-time-0000 \
    pnpm --filter @yatri/admin build

FROM node:20-alpine AS runtime
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
WORKDIR /app
# Next's standalone output contains only what the server needs, laid out from the repository root.
COPY --from=build /repo/apps/admin/.next/standalone ./
COPY --from=build /repo/apps/admin/.next/static ./apps/admin/.next/static
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/login >/dev/null || exit 1
CMD ["node", "apps/admin/server.js"]
