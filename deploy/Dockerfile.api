# syntax=docker/dockerfile:1
#
# The Yatri API. Build from the repository root:
#   docker build -f deploy/Dockerfile.api --target runtime -t yatri-api:<release> .
#   docker build -f deploy/Dockerfile.api --target migrate -t yatri-api-migrate:<release> .
#
# Two images from one file: `runtime` is what serves traffic (production dependencies only, no
# compiler, non-root); `migrate` carries the migration tool and runs `up` once per release, before
# the new runtime starts. Configuration comes only from environment variables (see
# apps/api/.env.example); nothing secret is baked into an image.

FROM node:20-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /repo

# ---- build: install everything, compile the shared package and the API
FROM base AS build
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/types/package.json packages/types/
COPY apps/api/package.json apps/api/
RUN pnpm install --frozen-lockfile --filter @yatri/api...
COPY packages/types packages/types
COPY apps/api apps/api
RUN pnpm --filter @yatri/types build && pnpm --filter @yatri/api build

# ---- migrate: the same tree, with the migration tool, run once per release
FROM build AS migrate
WORKDIR /repo/apps/api
ENV NODE_ENV=production
CMD ["pnpm", "exec", "node-pg-migrate", "up", "--migrations-dir", "migrations"]

# ---- production dependencies only
FROM build AS prod-deps
RUN pnpm install --frozen-lockfile --prod --filter @yatri/api...

# ---- runtime
FROM node:20-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /repo
COPY --from=prod-deps /repo/node_modules ./node_modules
COPY --from=prod-deps /repo/packages/types ./packages/types
COPY --from=prod-deps /repo/apps/api/node_modules ./apps/api/node_modules
COPY --from=build /repo/apps/api/package.json ./apps/api/package.json
COPY --from=build /repo/apps/api/dist ./apps/api/dist
WORKDIR /repo/apps/api
USER node
EXPOSE 4000
# Liveness only: the process answers. Readiness (/api/v1/health/ready) is for the load balancer.
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:4000/api/v1/health/live >/dev/null || exit 1
# `node` directly (not `pnpm start`) so SIGTERM reaches the process and shutdown is orderly.
CMD ["node", "dist/index.js"]
