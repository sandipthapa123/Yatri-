# Values for deploy/docker-compose.yml. Copy to deploy/compose.env (git-ignored) and fill in EVERY
# line. Generate each secret with:   openssl rand -base64 48
# Nothing here has a working default on purpose: a stack that starts must have been configured.

YATRI_ENV=staging
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
STORAGE_SIGNING_SECRET=
FIELD_ENCRYPTION_SECRET=

# Public https addresses (the API refuses to start in staging/production with localhost or http here)
CORS_ORIGINS=https://admin.example.org
PUBLIC_BASE_URL=https://api.example.org

# A real SMS gateway is required outside development (see apps/api/.env.example, SMS_PROVIDER)
SMS_PROVIDER=http
SMS_HTTP_ENDPOINT=
SMS_HTTP_API_KEY=

# Maps: the public OpenStreetMap server forbids production use; point at your own or a commercial service
LOCATION_PROVIDER=nominatim
LOCATION_PROVIDER_BASE_URL=
LOCATION_PROVIDER_API_KEY=
LOCATION_PROVIDER_USER_AGENT=Yatri-API/1.0 (ops@example.org)

# Optional: identifies the release in logs and health checks
APP_VERSION=
