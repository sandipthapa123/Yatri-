{
  "name": "yatri",
  "version": "0.1.0",
  "private": true,
  "description": "Yatri — a ride-sharing platform for Nepal.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev:passenger": "pnpm --filter @yatri/passenger start",
    "dev:driver": "pnpm --filter @yatri/driver start",
    "dev:admin": "pnpm --filter @yatri/admin dev",
    "dev:api": "pnpm --filter @yatri/api dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^17.12.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv",
        "GHSA-vfj7-8cjw-p6xm"
      ]
    },
    "overrides": {
      "shell-quote": "^1.11.0",
      "source-map-js": "^1.2.2"
    }
  }
}
