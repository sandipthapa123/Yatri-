{
  "name": "@yatri/types",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript types, constants and pure rules used across Yatri apps and the API (the single source of truth for shared contracts).",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
